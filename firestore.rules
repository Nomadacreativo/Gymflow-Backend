rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'inoxone.art@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    // Member Validation
    function isValidMember(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('plan' in data) || (data.plan is string && data.plan.size() <= 50))
        && (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    // Access Event Validation
    function isValidAccessEvent(data) {
      return (!('memberName' in data) || (data.memberName is string && data.memberName.size() <= 100))
        && (!('terminal' in data) || (data.terminal is string && data.terminal.size() <= 100))
        && (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    // Plan Validation
    function isValidPlan(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('price' in data) || data.price is number)
        && (!('period' in data) || (data.period is string && data.period.size() <= 50));
    }

    // Terminal Validation
    function isValidTerminal(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('model' in data) || (data.model is string && data.model.size() <= 50))
        && (!('zone' in data) || (data.zone is string && data.zone.size() <= 100));
    }

    // Instructor Validation
    function isValidInstructor(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 100));
    }

    // System Alert Validation
    function isValidAlert(data) {
      return (!('title' in data) || (data.title is string && data.title.size() <= 150))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    match /test/{testId} {
      allow read: if isSignedIn();
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(memberId) && isValidMember(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(memberId)) || isAdmin();
    }

    match /accessEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(eventId) && isValidAccessEvent(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(eventId)) || isAdmin();
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(planId) && isValidPlan(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(planId)) || isAdmin();
    }

    match /terminals/{terminalId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(terminalId) && isValidTerminal(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(terminalId)) || isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(instructorId) && isValidInstructor(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(instructorId)) || isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && isValidId(alertId) && isValidAlert(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(alertId)) || isAdmin();
    }
  }
}
